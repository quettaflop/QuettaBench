__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Run output and logs stay on the box that produced them.
results/
logs/
*.log
!tests/golden/fixtures/*.log

# Local agent and tool state; AGENTS.md is the tracked agent file.
.claude/
.omc/

# Large datasets live on R2 (see data/fetch.py), not in git.
data/*.jsonl
data/mooncake/*.jsonl
data/mooncake/*.fit.json

# Scratch output from distribution rebuilds / re-baselines.
data/_rebuilt*/
data/_pre_rebaseline_*/
data/_holdout_*.jsonl

# provision.py writes the resolved run env here (the justfile loads it); host-specific.
.env
*.whl
